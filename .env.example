# ============================================================================
# WHALEGOD Configuration
# Copy this file to .env and fill in your API keys
#   cp .env.example .env && nano .env
# ============================================================================

# === REQUIRED: Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get from @BotFather on Telegram — create a bot and paste the token

# === REQUIRED: Solana API ===
HELIUS_API_KEY=your_helius_api_key_here
# Free at: https://helius.dev — sign up, create project, copy API key (10 RPS free)

# === REQUIRED: Ethereum APIs ===
ALCHEMY_API_KEY=your_alchemy_api_key_here
# Free at: https://www.alchemy.com — create app on Ethereum Mainnet, copy API key

ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Free at: https://etherscan.io/apis — create account, generate API key (5 calls/sec)

# === OPTIONAL: Price Fallback ===
COINGECKO_API_KEY=
# Free demo key at: https://www.coingecko.com/en/api
# Only used as fallback — bot works fine without it

# === WEBHOOK (for Helius real-time Solana events) ===
# This enables real-time Solana whale alerts via Helius webhooks.
# Without this, Solana events rely on the tracked-wallet poller only.
#
# HOW TO SET UP:
#   1. Set WEBHOOK_HOST to your server's public IP (e.g. 203.0.113.50)
#      or domain (e.g. myserver.example.com)
#   2. Ensure port 9876 is open in your firewall / security group
#   3. The bot will auto-register the webhook with Helius on startup
#   4. Helius will POST events to http://YOUR_HOST:9876/webhook/helius
#
# If you're behind a reverse proxy (nginx/caddy), set the public URL host
# and forward traffic from that port to the container.
WEBHOOK_HOST=
WEBHOOK_PORT=9876

# === ADMIN NOTIFICATIONS ===
# Your personal Telegram chat ID (bot sends startup/error notifications here)
# Get it from @userinfobot on Telegram — message it and it replies with your ID
ADMIN_CHAT_ID=

# === THRESHOLDS (defaults — users can customize via /settings) ===
DEFAULT_SOL_THRESHOLD=500
DEFAULT_ETH_THRESHOLD=50
DEFAULT_USD_THRESHOLD=50000
DEFAULT_LP_THRESHOLD=25000

# === DONATION WALLETS (optional — shown in /donate command) ===
DONATE_SOL=
DONATE_ETH=
DONATE_BTC=
DONATE_USDT_TRC20=

# === DATABASE ===
# Docker: use /app/data/whalegod.db (default, persisted via volume)
# Bare-metal: use data/whalegod.db
DB_PATH=data/whalegod.db

# === OPERATIONAL ===
LOG_RETENTION_DAYS=7
MAX_WALLETS_PER_USER=10
FLOOD_THRESHOLD=20
FLOOD_WINDOW_SECONDS=60

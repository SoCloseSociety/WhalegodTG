# ============================================================================
# WHALEGOD Configuration
# Copy this file to .env and fill in your API keys
#   cp .env.example .env && nano .env
# ============================================================================

# === REQUIRED: Telegram Bot ===
TELEGRAM_BOT_TOKEN=
# Get from @BotFather on Telegram

# === REQUIRED: Solana API ===
HELIUS_API_KEY=
# Free at: https://helius.dev (10 RPS free tier)

# === REQUIRED: Ethereum APIs ===
ALCHEMY_API_KEY=
# Free at: https://www.alchemy.com (300M compute units/month)

ETHERSCAN_API_KEY=
# Free at: https://etherscan.io/apis (5 calls/sec)

# === OPTIONAL: Price Fallback ===
COINGECKO_API_KEY=
# Free demo key at: https://www.coingecko.com/en/api
# Only used as fallback — bot works fine without it

# === WEBHOOK (for Helius real-time Solana events) ===
# Set to your server's public IP or domain
WEBHOOK_HOST=
WEBHOOK_PORT=9876

# === ADMIN NOTIFICATIONS ===
# Your personal Telegram chat ID (bot sends startup/error notifications here)
# Get it from @userinfobot on Telegram
ADMIN_CHAT_ID=

# === THRESHOLDS (defaults — users can customize via /settings) ===
DEFAULT_SOL_THRESHOLD=500
DEFAULT_ETH_THRESHOLD=50
DEFAULT_USD_THRESHOLD=50000
DEFAULT_LP_THRESHOLD=25000

# === DONATION WALLETS (optional — shown in /donate command) ===
DONATE_SOL=
DONATE_ETH=
DONATE_BTC=
DONATE_USDT_TRC20=

# === DATABASE ===
# Docker: use /app/data/whalegod.db (default)
# Bare-metal: use data/whalegod.db
DB_PATH=data/whalegod.db

# === OPERATIONAL ===
LOG_RETENTION_DAYS=7
MAX_WALLETS_PER_USER=10
FLOOD_THRESHOLD=20
FLOOD_WINDOW_SECONDS=60
